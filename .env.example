# Client config (SvelteKit public env — safe to commit the URL, never secrets)
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Legacy Vite-style fallback (also read by the app if set)
# VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Convex CLI deployment (used by `pnpm exec convex dev`)
# CONVEX_DEPLOYMENT=dev:your-deployment
