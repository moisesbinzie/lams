{
	"name": "lams",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"deploy": "vite build && wrangler deploy",
		"deploy:dry": "vite build && wrangler deploy --dry-run",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test src/lib/lams/csv.test.ts src/lib/lams/time.test.ts src/lib/lams/geo.test.ts src/lib/lams/station.test.ts src/lib/lams/session-state.test.ts tests/errors.test.ts tests/convex-helpers.test.ts tests/convex-proximity.test.ts",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.67.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^26.6.6",
		"@types/qrcode": "^1.5.6",
		"bits-ui": "^2.20.4",
		"cn": "^0.4.0",
		"mode-watcher": "^1.1.0",
		"shadcn-svelte": "^1.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"wrangler": "^4.157.0"
	},
	"dependencies": {
		"convex": "^1.49.0",
		"convex-svelte": "^0.14.0",
		"jsqr": "^1.4.0",
		"qrcode": "^1.5.4",
		"svelte-sonner": "^1.2.3"
	}
}
